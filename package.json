{
  "name": "registro-servicio-social",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production --aot --base-href=/app/registro-servicio-social/",
    "analyze-esbuild": "esbuild src/main.ts --bundle --metafile=dist/meta.json --outfile=dist/out.js",
    "compodoc:build": "compodoc -d dist/documentation/ -p tsconfig.doc.json -n \"Registro servicio social\" --theme material --language es-ES",
    "compodoc:build-and-serve": "compodoc -d dist/documentation/ -p tsconfig.doc.json -n \"Registro servicio social\" --theme material --language es-ES -s",
    "compodoc:serve": "compodoc -s",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@csi-sie/iest-theme-material": "^3.7.1",
    "@csi-sie/ngx-iest-base": "^3.3.1",
    "html5-qrcode": "^2.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
